# MAPS: só o template é público — ele é parte da ferramenta.
# Os maps dos projetos são DADOS e vivem no repo privado ai-flow-maps,
# ligados aqui por symlink via scripts/link-maps.sh (e por isso ignorados).
MAPS/*
!MAPS/_template
!MAPS/_template/**

# Orchestrator — estado de runtime local, não versionado
# (events.log é só de depuração: o server.js escreve, ninguém lê)
ORCHESTRATOR/events.log
ORCHESTRATOR/*.log

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
*.swo

# Dependencies
node_modules/
