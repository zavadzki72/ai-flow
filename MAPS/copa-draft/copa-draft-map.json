{
  "project": {
    "name": "Copa Draft",
    "description": "Jogo de Copa do Mundo estilo Brasfoot. Mono-repo: frontend 100% no navegador (monta um time dos sonhos rolando um dado e disputa um mata-mata simulado minuto a minuto com narração em PT-BR) + backend .NET 10 para o modo multiplayer online (salas, contas, torneio simulado no servidor em tempo real).",
    "team": "Personal",
    "status": "active"
  },
  "stack": {
    "backend": ["csharp", "dotnet-10", "aspnet-core", "signalr", "ef-core", "postgresql"],
    "frontend": ["html", "css", "javascript", "react-cdn", "babel"],
    "infra": ["docker", "nginx", "vps"]
  },
  "architecture": {
    "pattern": "Mono-repo (frontend SPA sem build + backend .NET) | SPA sem build no frontend",
    "style": "state-machine (frontend) + server-authoritative realtime (backend)"
  },
